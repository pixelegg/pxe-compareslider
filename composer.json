{
    "name": "pixelegg/pxe-compareslider",
    "type": "typo3-cms-extension",
    "description": "Before/after image comparison slider content element for TYPO3. Dependency-free vanilla JavaScript, keyboard-accessible, horizontal or vertical.",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "TYPO3 CMS",
        "content-element",
        "before-after",
        "image-comparison",
        "compare-slider"
    ],
    "homepage": "https://www.pixelegg.de",
    "support": {
        "issues": "https://github.com/pixelegg/pxe-compareslider/issues",
        "source": "https://github.com/pixelegg/pxe-compareslider",
        "docs": "https://github.com/pixelegg/pxe-compareslider#readme"
    },
    "authors": [
        {
            "name": "pixelegg",
            "email": "info@pixelegg.de",
            "homepage": "https://www.pixelegg.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-extbase": "^13.4 || ^14.0",
        "typo3/cms-fluid": "^13.4 || ^14.0",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.0",
        "typo3/cms-frontend": "^13.4 || ^14.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "saschaegerer/phpstan-typo3": "^2.2 || ^3.0",
        "ssch/typo3-rector": "^3.0",
        "typo3/coding-standards": "^0.8 || ^0.9",
        "typo3/testing-framework": "^8.2 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "Pixelegg\\PxeCompareslider\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pixelegg\\PxeCompareslider\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "pxe_compareslider"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ci:cs": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "ci:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
        "ci:rector": "rector process --dry-run",
        "ci:stan": "phpstan analyse --no-progress",
        "ci:test": "phpunit -c phpunit.xml.dist --testsuite unit",
        "ci:test:functional": "phpunit -c phpunit.functional.xml.dist --testsuite functional"
    }
}
